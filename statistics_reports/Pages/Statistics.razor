@page "/statistics"

@using System.Linq
@using statistics_reports.Services
@using statistics_reports.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject SupabaseClient SupabaseClient
@inject SupabaseSession SupabaseSession
@inject NavigationManager Navigation

<h3>Статистика</h3>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
@if (!SessionChecked)
{
    <p>Проверка входа...</p>
}
else if (!SupabaseSession.IsAuthenticated)
{
    <div class="alert alert-warning">
        Вы не авторизованы. Пожалуйста, войдите в систему.
    </div>
    <button class="btn btn-primary" @onclick="GoToLogin">Перейти на страницу входа</button>
}
else
{
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <!-- ФИЛЬТР -->
    <div class="card mb-3">
        <div class="card-body">
            <h5>Фильтр</h5>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Nr сотрудника</label>
                    <input class="form-control" type="number"
                           @oninput="OnFilterWorkerNrInput"
                           value="@FilterWorkerNr" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Работник (по имени)</label>
                    <select class="form-select"
                            value="@FilterWorkerIdString"
                            @onchange="OnFilterWorkerSelectChanged">
                        <option value="">Все</option>
                        @foreach (var w in WorkersList)
                        {
                            <option value="@w.Id">@w.Name (@w.Nr)</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">С даты</label>
                    <input class="form-control" type="date" @bind="FromDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">По дату</label>
                    <input class="form-control" type="date" @bind="ToDate" />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="OnApplyFilter">
                        Применить
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ДОБАВИТЬ ЗАПИСЬ -->
    <div class="card mb-3">
        <div class="card-body">
            <h5>Добавить запись</h5>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Nr сотрудника</label>
                    <input class="form-control" type="number"
                           @oninput="OnNewWorkerNrInput"
                           value="@NewWorkerNr" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Работник (по имени)</label>
                    <select class="form-select"
                            value="@NewWorkerIdString"
                            @onchange="OnNewWorkerSelectChanged">
                        <option value="">-- выбрать --</option>
                        @foreach (var w in WorkersList.Where(w => w.IsActive == true))
                        {
                            <option value="@w.Id">@w.Name (@w.Nr)</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Дата</label>
                    <input class="form-control" type="date" @bind="NewWorkDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Количество (Menge)</label>
                    <input class="form-control" type="number" @bind="NewMenge" />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-success w-100" @onclick="OnAddStatistic">
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ТАБЛИЦА -->
    @if (IsLoading)
    {
        <p>Загрузка статистики...</p>
    }
    else if (StatisticsList.Count == 0 && IsLoading == false)
    {
        <p>Записей не найдено.</p>
    }
    else
    {
        <div class="table-responsive"> <!-- ДОБАВЛЕН ЗАКРЫВАЮЩИЙ ТЕГ -->
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th @onclick="() => ChangeStatsSort(StatsSortColumn.Date)"
                            style="width: 15%; cursor: pointer; white-space: nowrap;">
                            Дата @GetStatsSortIcon(StatsSortColumn.Date)
                        </th>
                        <th @onclick="() => ChangeStatsSort(StatsSortColumn.Worker)"
                             style="width: 25%; cursor: pointer; white-space: nowrap;">
                            Работник @GetStatsSortIcon(StatsSortColumn.Worker)
                        </th>
                        <th style="width: 10%;"> Nr</th>
                        <th style="width: 15%;"> Arbeitsplatz</th>
                        <th @onclick="() => ChangeStatsSort(StatsSortColumn.Menge)"
                             style="width: 10%; cursor: pointer; white-space: nowrap;">
                            Menge @GetStatsSortIcon(StatsSortColumn.Menge)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in SortedStatistics)
                    {
                        var worker = WorkersList.FirstOrDefault(w => w.Id == row.WorkerId);
                        <tr>
                            <td>@row.WorkDate.ToString("dd-MM-yyyy")</td>
                            <td>@worker?.Name</td>
                            <td>@worker?.Nr</td>
                            <td>@worker?.Arbeitsplatz</td>
                            <td>@row.Menge</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div> <!-- ЗАКРЫТИЕ ТЕГА div -->
    }
} <!-- ЗАКРЫТИЕ БЛОКА else -->

@code
{
    // ==== ДАННЫЕ ====

    // Список работников
    private List<Worker> WorkersList { get; set; } = new();

    // Список строк статистики
    private List<StatisticRow> StatisticsList { get; set; } = new();

    // Флаги состояния
    private bool SessionChecked { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    // --- ФИЛЬТР ---

    // Nr сотрудника (фильтр)
    private string? FilterWorkerNr { get; set; } = "";

    // Выбранный работник (Id) в фильтре — в виде строки для <select>
    private string? FilterWorkerIdString { get; set; }

    // Период дат для фильтра
    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }

    // --- ДОБАВЛЕНИЕ ---

    // Nr сотрудника (форма добавления)
    private string? NewWorkerNr { get; set; } = "";

    // Выбранный работник (Id) в форме добавления — строкой для <select>
    private string? NewWorkerIdString { get; set; }

    // Дата и количество для новой записи
    private DateTime? NewWorkDate { get; set; }
    private int? NewMenge { get; set; }

    // ==== ИНИЦИАЛИЗАЦИЯ ====

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        // Поднимаем токен из localStorage
        await SupabaseSession.InitializeAsync();
        SessionChecked = true;

        if (!SupabaseSession.IsAuthenticated)
        {
            IsLoading = false;
            return;
        }

        await LoadWorkersAsync();

        // По умолчанию — текущий месяц
        var today = DateTime.Today;
        FromDate = new DateTime(today.Year, today.Month, 1);
        ToDate = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));

        // Для формы добавления — сегодняшняя дата
        NewWorkDate = today;

        await LoadStatisticsAsync();
    }

    // ==== ЗАГРУЗКА ДАННЫХ ====

    private async Task LoadWorkersAsync()
    {
        try
        {
            WorkersList = await SupabaseClient.GetWorkersAsync();
        }
        catch (Exception ex)
        {
            // при желании можно обработать JWT expired так же, как на других страницах
            ErrorMessage = $"Statistics.razor-LoadWorkersAsync-Ошибка загрузки работников: {ex.Message}";
        }
    }

    private async Task LoadStatisticsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            long? workerId = ParseLong(FilterWorkerIdString);
            StatisticsList = await SupabaseClient.GetStatisticsAsync(FromDate, ToDate, workerId);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Statistics.razor-LoadStatisticsAsync-Ошибка загрузки статистики: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnApplyFilter()
    {
        await LoadStatisticsAsync();
    }

    // ==== СИНХРОНИЗАЦИЯ ФИЛЬТРА (Nr <-> Имя) ====

    // Пользователь меняет Nr в фильтре
    private void OnFilterWorkerNrInput(ChangeEventArgs e)
    {
        FilterWorkerNr = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(FilterWorkerNr))
        {
            // Если Nr пустой — сбрасываем выбранного работника
            FilterWorkerIdString = null;
            return;
        }

        var w = WorkersList.FirstOrDefault(x => x.Nr == FilterWorkerNr);
        if (w != null)
        {
            // Нашли работника по Nr — подставляем его Id в select
            FilterWorkerIdString = w.Id.ToString();
        }
        else
        {
            // Нет такого Nr — оставляем select пустым
            FilterWorkerIdString = null;
        }
    }

    // Пользователь выбирает работника в фильтре по имени
    private void OnFilterWorkerSelectChanged(ChangeEventArgs e)
    {
        FilterWorkerIdString = e.Value?.ToString();

        if (long.TryParse(FilterWorkerIdString, out var id))
        {
            var w = WorkersList.FirstOrDefault(x => x.Id == id);
            if (w != null)
            {
                FilterWorkerNr = w.Nr;
            }
        }
        else
        {
            // Выбрано "Все"
            FilterWorkerNr = null;
        }
    }

    // ==== СИНХРОНИЗАЦИЯ ФОРМЫ ДОБАВЛЕНИЯ (Nr <-> Имя) ====

    // Пользователь меняет Nr в форме добавления
    private void OnNewWorkerNrInput(ChangeEventArgs e)
    {
        NewWorkerNr = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(NewWorkerNr))
        {
            NewWorkerIdString = null;
            return;
        }

        var w = WorkersList.FirstOrDefault(x => x.Nr == NewWorkerNr);
        if (w != null)
        {
            NewWorkerIdString = w.Id.ToString();
        }
        else
        {
            NewWorkerIdString = null;
        }
    }

    // Пользователь выбирает работника по имени в форме добавления
    private void OnNewWorkerSelectChanged(ChangeEventArgs e)
    {
        NewWorkerIdString = e.Value?.ToString();

        if (long.TryParse(NewWorkerIdString, out var id))
        {
            var w = WorkersList.FirstOrDefault(x => x.Id == id);
            if (w != null)
            {
                NewWorkerNr = w.Nr;
            }
        }
        else
        {
            NewWorkerNr = null;
        }
    }

    // ==== ДОБАВЛЕНИЕ ЗАПИСИ ====

    private async Task OnAddStatistic()
    {
        ErrorMessage = null;

        var workerId = ParseLong(NewWorkerIdString);

        if (workerId == null || NewWorkDate == null || NewMenge == null)
        {
            ErrorMessage = "Выберите работника, дату и введите количество.";
            return;
        }

        try
        {
            var created = await SupabaseClient.InsertStatisticAsync(workerId.Value, NewWorkDate.Value, NewMenge.Value);
            if (created != null)
            {
                // Если запись попадает в текущий фильтр — можно добавить в список
                StatisticsList.Add(created);
                // Или можно полностью перезагрузить:
                // await LoadStatisticsAsync();

                // Сбросим количество
                NewMenge = null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Ошибка добавления записи: {ex.Message}";
        }
    }

    // ==== ВСПОМОГАТЕЛЬНОЕ ====

    private static long? ParseLong(string? s)
    {
        if (string.IsNullOrWhiteSpace(s))
            return null;

        return long.TryParse(s, out var v) ? v : null;
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    // --- СОРТИРОВКА ДЛЯ СТАТИСТИКИ ---

    private enum StatsSortColumn
    {
        Date,
        Worker,
        Menge
    }

    private StatsSortColumn CurrentStatsSort { get; set; } = StatsSortColumn.Date;
    private bool StatsSortAscending { get; set; } = true;

    // Отсортированный список для отображения
    private IEnumerable<StatisticRow> SortedStatistics
    {
        get
        {
            IEnumerable<StatisticRow> query = StatisticsList;

            switch (CurrentStatsSort)
            {
                case StatsSortColumn.Date:
                    query = StatsSortAscending
                        ? query.OrderBy(r => r.WorkDate)
                        : query.OrderByDescending(r => r.WorkDate);
                    break;

                case StatsSortColumn.Worker:
                    query = StatsSortAscending
                        ? query.OrderBy(r => GetWorkerName(r.WorkerId))
                        : query.OrderByDescending(r => GetWorkerName(r.WorkerId));
                    break;

                case StatsSortColumn.Menge:
                    query = StatsSortAscending
                        ? query.OrderBy(r => r.Menge)
                        : query.OrderByDescending(r => r.Menge);
                    break;
            }

            return query;
        }
    }

    private void ChangeStatsSort(StatsSortColumn column)
    {
        if (CurrentStatsSort == column)
        {
            StatsSortAscending = !StatsSortAscending;
        }
        else
        {
            CurrentStatsSort = column;
            StatsSortAscending = true;
        }
    }

    private MarkupString GetStatsSortIcon(StatsSortColumn column)
    {
        if (CurrentStatsSort != column)
            return new MarkupString(string.Empty);

        var arrow = StatsSortAscending ? "▲" : "▼";
        return new MarkupString($"{arrow}");
    }

    // Вспомогательный метод: вернуть имя работника по WorkerId
    private string GetWorkerName(long workerId)
    {
        var worker = WorkersList.FirstOrDefault(w => w.Id == workerId);
        return worker?.Name ?? string.Empty;
    }
}