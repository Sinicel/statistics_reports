@page "/login"

@using statistics_reports.Services
@inject SupabaseClient SupabaseClient
@inject SupabaseSession SupabaseSession
@inject NavigationManager Navigation

<h3>Вход</h3>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<div class="mb-3">
    <label class="form-label">Email</label>
    <input class="form-control" @bind="Email" />
</div>

<div class="mb-3">
    <label class="form-label">Пароль</label>
    <input class="form-control" type="password" @bind="Password" />
</div>

<button class="btn btn-primary" @onclick="OnLoginClicked" disabled="@IsBusy">
    @if (IsBusy)
    {
        <span>Входим...</span>
    }
    else
    {
        <span>Войти</span>
    }
</button>

@code {
    // Email и пароль пользователя Supabase (Auth → Users)
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    // Флаг выполнения операции
    private bool IsBusy { get; set; }

    // Текст ошибки
    private string? ErrorMessage { get; set; }

    private async Task OnLoginClicked()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "Введите email и пароль.";
            return;
        }

        IsBusy = true;
        try
        {
            await SupabaseClient.LoginAsync(Email, Password);

            // Переходим на страницу работников
            Navigation.NavigateTo("/workers");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}
