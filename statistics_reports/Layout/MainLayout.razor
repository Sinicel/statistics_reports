@using statistics_reports.Services
@using statistics_reports.Pages

@inherits LayoutComponentBase
@inject SupabaseSession SupabaseSession

<PageTitle>Statistics Reports</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="main-content px-4">
            @* Здесь будет показываться содержимое конкретной страницы *@
            @Body
        </div>
    </main>
</div>
 @code {
    private bool _sessionInitialized;

    protected override async Task OnInitializedAsync()
    {
        // Инициализируем сессию один раз на всё приложение
        if (!_sessionInitialized)
        {
            await SupabaseSession.InitializeAsync();
            _sessionInitialized = true;
        }
    }
} 
 