@using statistics_reports.Services
@inject SupabaseSession SupabaseSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">statistics_reports</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Главная
            </NavLink>
        </div>

        @* Показываем "Вход", только если пользователь не авторизован *@
        @if (!SupabaseSession.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> 👤 Вход
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="workers">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 👷 Работники
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink href="statistics" class="nav-link">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 📊 Статистика
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink href="chart" class="nav-link">
                <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> 📈 График
            </NavLink>
        </div>


        @* Кнопка "Выход" показывается только когда пользователь залогинен *@
        @if (SupabaseSession.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <button type="button"
                        class="nav-link btn btn-link p-0"
                        @onclick:stopPropagation="true"
                        @onclick="OnLogoutClicked">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Выход
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        // Подписываемся на изменения состояния сессии,
        // чтобы меню сразу реагировало на логин/логаут.
        SupabaseSession.OnChange += OnSessionChanged;
    }

    // Этот метод будет вызываться при каждом изменении токена/сессии
    private void OnSessionChanged()
    {
        // Обновляем UI в правильном контексте синхронизации
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Обработчик нажатия на кнопку "Выход"
    private async Task OnLogoutClicked()
    {
        // Очищаем токен/сессию
        await SupabaseSession.ClearAsync();

        // Перенаправляем на страницу логина
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    // Отписываемся от события, когда компонент уничтожается,
    // чтобы избежать утечек памяти и лишних вызовов.
    public void Dispose()
    {
        SupabaseSession.OnChange -= OnSessionChanged;
    }
}
