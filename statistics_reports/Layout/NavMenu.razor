@using statistics_reports.Services
@inject SupabaseSession SupabaseSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Statistics & Reports</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
@*         <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Главная
            </NavLink>
        </div> *@

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="workers">
                <span class="bi bi-bar-worker-fill-nav-menu" aria-hidden="true"></span>  Работники
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink href="statistics" class="nav-link">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>  Статистика
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink href="chart" class="nav-link">
                <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span>  График
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink href="month-table" class="nav-link">
                <span class="bi bi-bar-table-fill-nav-menu" aria-hidden="true"></span> Таблица
            </NavLink>
        </div>

        @* ОДИН пункт меню "Вход/Выход" как обычный элемент, сразу после остальных *@
        <div class="nav-item px-3">
            <a href="login"
               class="@AuthLinkClass"
               @onclick:preventDefault="true"
               @onclick="OnAuthLinkClicked">
                <span class="@AuthIconClass" aria-hidden="true"></span> @AuthText
            </a>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        // Подписываемся на изменения состояния сессии,
        // чтобы пункт "Вход/Выход" сразу обновлялся
        SupabaseSession.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Текст ссылки
    private string AuthText => SupabaseSession.IsAuthenticated ? "Выход" : "Вход";

    // Иконка
    private string AuthIconClass => SupabaseSession.IsAuthenticated
        ? "bi bi-box-logout-nav-menu"
        : "bi bi-box-login-nav-menu";

    // Класс ссылки (цвет)
    private string AuthLinkClass => SupabaseSession.IsAuthenticated
        ? "nav-link text-danger"   // залогинен → "Выход" красным
        : "nav-link text-success"; // не залогинен → "Вход" зелёным

    // Универсальный обработчик клика по пункту "Вход/Выход"
    private async Task OnAuthLinkClicked()
    {
        if (SupabaseSession.IsAuthenticated)
        {
            // Если авторизован — выходим и ведём на логин
            await SupabaseSession.ClearAsync();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        else
        {
            // Если не авторизован — просто ведём на логин
            Navigation.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        SupabaseSession.OnChange -= OnSessionChanged;
    }
}
